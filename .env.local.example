NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI provider — "mock" needs no key; "groq" uses a real LLM (Llama 3.3 70B via Groq)
AI_PROVIDER=mock
# GROQ_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional — invite emails (school admin inviting a teacher, teacher inviting a
# student) work without this: the accept link is just shown in the UI to copy
# instead of being emailed. Get a key at https://resend.com (free tier is enough).
# RESEND_API_KEY=
# Must be a verified sending domain in Resend for production; the sandbox
# address below works for testing without domain verification.
# EMAIL_FROM=Brightpath <onboarding@resend.dev>

# Used to build the invite accept link (falls back to localhost:3000 if unset).
# NEXT_PUBLIC_SITE_URL=
